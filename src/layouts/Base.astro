---
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import CommandBar from '../components/CommandBar.astro';
import cv from '../content/cv.json';
import theme from '../content/theme.json';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = cv.seo.title,
  description = cv.seo.description,
  noindex = false,
} = Astro.props;

// Colour tokens from theme.json. "html:root" beats the defaults in global.css
// whatever order the stylesheets end up in.
const hex = (v: string) => (/^#[0-9a-f]{6}$/i.test(v) ? v : null);
const vars: [string, string][] = [
  ['bg', theme.bg], ['surface', theme.surface], ['line', theme.line], ['line-2', theme.line2],
  ['fg', theme.fg], ['soft', theme.soft], ['dim', theme.dim], ['accent', theme.accent], ['alert', theme.alert],
];
// Link-preview image (public/og.png, made by tools/og.mjs). Needs an absolute URL.
const ogImage = new URL('/og.png', Astro.site ?? 'https://joaodiasworks.com').href;
const themeCss =`html:root{${vars.filter(([, v]) => hex(v)).map(([k, v]) => `--${k}:${v}`).join(';')}}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={hex(theme.bg) ?? '#02050b'} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A glowing blue shield with a padlock, rebuilt from a shattered red padlock." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/ClashDisplay-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={themeCss}></style>
    <script is:inline>
      // Set the motion state before first paint so nothing animates when it shouldn't.
      (function () {
        var root = document.documentElement, saved = null;
        root.classList.add('js');
        try { saved = localStorage.getItem('jd-motion'); } catch (e) {}
        var off = saved ? saved === 'off' : matchMedia('(prefers-reduced-motion: reduce)').matches;
        root.dataset.motion = off ? 'off' : 'on';
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <MobileMenu />
    <slot />
    <Footer />
    <CommandBar />
    <script>
      import '../scripts/reveal';
      import '../scripts/clock';
    </script>
  </body>
</html>

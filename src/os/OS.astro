---
// Website OS (dev only, injected by ./integration.mjs). Edit copy, colours and SEO,
// check copy against BRAND.md, and preview at three widths. Saving writes
// src/content/cv.json and src/content/theme.json; the dev server reloads the preview.
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Website OS</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="top">
      <div class="brand"><b>jd<span>.</span></b> Website OS <span class="tag">local · dev only</span></div>
      <div class="status" data-status role="status">Loading…</div>
      <div class="actions">
        <button type="button" class="ghost" data-revert>Revert</button>
        <button type="button" class="primary" data-save disabled>Save <kbd>Ctrl S</kbd></button>
      </div>
    </header>

    <main class="shell">
      <aside class="panel">
        <nav class="tabs" role="tablist" aria-label="Editor sections">
          <button role="tab" data-tab="copy">Copy</button>
          <button role="tab" data-tab="projects">Projects</button>
          <button role="tab" data-tab="cv">CV</button>
          <button role="tab" data-tab="design">Design</button>
          <button role="tab" data-tab="seo">SEO</button>
          <button role="tab" data-tab="check">Check <span class="badge" data-badge></span></button>
        </nav>
        <div class="pane" data-pane role="tabpanel"></div>
      </aside>

      <section class="preview">
        <div class="bar">
          <div class="devices" role="group" aria-label="Preview width">
            <button type="button" data-device="1440">Desktop <span>1440</span></button>
            <button type="button" data-device="768">Tablet <span>768</span></button>
            <button type="button" data-device="375">Phone <span>375</span></button>
          </div>
          <div class="right">
            <button type="button" class="ghost sm" data-reload>Reload</button>
            <a class="ghost sm" href="/" target="_blank" rel="noopener">Open site ↗</a>
          </div>
        </div>
        <div class="stage" data-stage>
          <div class="frame" data-frame><iframe src="/" title="Site preview" data-iframe></iframe></div>
        </div>
      </section>
    </main>

    <script>
      import './os-client';
    </script>
  </body>
</html>

<style is:global>
  @font-face { font-family: 'Satoshi'; src: url('/fonts/Satoshi-Variable.woff2') format('woff2'); font-weight: 300 900; font-display: swap; }
  :root {
    --bg: #07080b; --surface: #0d0f14; --raise: #12151c; --line: #1b1e26; --line-2: #262a35;
    --fg: #eef0f5; --soft: #c3c7d3; --dim: #8b90a0; --accent: #ffb547;
    --err: #ff6b4a; --warn: #ffb547; --info: #7cc4ff; --ok: #6fd3a0;
    --mono: 'Geist Mono', ui-monospace, Consolas, monospace;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body { background: var(--bg); color: var(--fg); font: 14px/1.5 'Satoshi', system-ui, sans-serif; overflow: hidden; }
  button, input, textarea, select { font: inherit; color: inherit; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }

  .top { height: 52px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 16px; border-bottom: 1px solid var(--line); }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 500; }
  .brand b { font-size: 18px; letter-spacing: -.02em; }
  .brand b span { color: var(--accent); }
  .tag { font: 11px var(--mono); color: var(--dim); padding: 2px 8px; border: 1px solid var(--line-2); border-radius: 999px; }
  .status { font: 12px var(--mono); color: var(--dim); }
  .status.dirty { color: var(--warn); }
  .status.ok { color: var(--ok); }
  .status.bad { color: var(--err); }
  .actions, .right { display: flex; gap: 8px; align-items: center; }
  kbd { font: 10px var(--mono); opacity: .7; margin-left: 6px; }
  .primary, .ghost { border-radius: 999px; padding: 7px 16px; cursor: pointer; border: 1px solid var(--line-2); background: rgba(255,255,255,.03); }
  .primary { background: var(--accent); border-color: var(--accent); color: var(--bg); font-weight: 600; }
  .primary:disabled { opacity: .35; cursor: default; }
  .ghost:hover { border-color: var(--accent); }
  .sm { padding: 5px 12px; font-size: 12px; text-decoration: none; }

  .shell { height: calc(100% - 52px); display: grid; grid-template-columns: 440px 1fr; }
  .panel { border-right: 1px solid var(--line); display: flex; flex-direction: column; min-height: 0; }
  .tabs { display: flex; gap: 2px; padding: 8px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .tabs button { background: none; border: 0; padding: 6px 10px; border-radius: 8px; cursor: pointer; color: var(--dim); }
  .tabs button:hover { color: var(--fg); }
  .tabs button[aria-selected='true'] { background: var(--raise); color: var(--fg); }
  .badge { font: 10px var(--mono); padding: 0 6px; border-radius: 999px; margin-left: 4px; }
  .badge.err { background: var(--err); color: var(--bg); }
  .badge.warn { background: var(--warn); color: var(--bg); }
  .badge.clean { background: var(--ok); color: var(--bg); }
  .pane { overflow-y: auto; padding: 16px 16px 60px; flex: 1; }

  .group { margin-bottom: 22px; }
  .group > h2 { font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--dim); margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
  details.group { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
  details.group > summary { cursor: pointer; font-weight: 500; list-style: none; display: flex; justify-content: space-between; gap: 8px; }
  details.group > summary::-webkit-details-marker { display: none; }
  details.group > summary span { font: 11px var(--mono); color: var(--dim); }
  details.group[open] > summary { margin-bottom: 12px; }
  .f { display: block; margin-bottom: 12px; }
  .f > span { display: flex; justify-content: space-between; font-size: 12px; color: var(--soft); margin-bottom: 4px; }
  .f > span em { font: normal 11px var(--mono); color: var(--dim); }
  .f > span em.over { color: var(--err); }
  .f input[type='text'], .f textarea { width: 100%; background: var(--surface); border: 1px solid var(--line-2); border-radius: 8px; padding: 8px 10px; outline: none; resize: vertical; }
  .f textarea { min-height: 64px; line-height: 1.45; }
  .f input:focus, .f textarea:focus { border-color: var(--accent); }
  .f.flash input, .f.flash textarea { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(255,181,71,.2); }
  .hint { font-size: 11px; color: var(--dim); margin-top: 4px; }
  .sep { border: 0; border-top: 1px solid var(--line); margin: 6px 0 16px; }
  .note code { font: 11px var(--mono); color: var(--soft); }
  .flags { display: grid; gap: 3px; margin-top: 5px; }
  .flag { font-size: 11.5px; padding-left: 10px; border-left: 2px solid; }
  .flag.error { color: var(--err); }
  .flag.warn { color: var(--warn); }
  .flag.info { color: var(--info); }
  .row-btns { display: flex; gap: 6px; margin: -4px 0 12px; }
  .row-btns button, .mini { font-size: 11px; padding: 3px 10px; border-radius: 999px; border: 1px solid var(--line-2); background: none; cursor: pointer; color: var(--dim); }
  .row-btns button:hover, .mini:hover { color: var(--fg); border-color: var(--accent); }

  .swatch { display: grid; grid-template-columns: 34px 1fr 90px; gap: 10px; align-items: center; margin-bottom: 8px; }
  .swatch input[type='color'] { width: 34px; height: 28px; border: 1px solid var(--line-2); border-radius: 6px; background: none; padding: 2px; cursor: pointer; }
  .swatch input[type='text'] { width: 100%; background: var(--surface); border: 1px solid var(--line-2); border-radius: 6px; padding: 5px 8px; font: 12px var(--mono); }
  .swatch label { font-size: 12px; color: var(--soft); }
  .swatch label small { display: block; color: var(--dim); font-size: 11px; }
  .presets { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }
  .presets button { display: inline-flex; align-items: center; gap: 6px; }
  .presets i { width: 10px; height: 10px; border-radius: 50%; }
  table.contrast { width: 100%; border-collapse: collapse; font-size: 12px; }
  .contrast td { padding: 6px 4px; border-bottom: 1px solid var(--line); }
  .contrast td:nth-child(2) { font-family: var(--mono); text-align: right; }
  .pass { color: var(--ok); } .fail { color: var(--err); }
  .note { font-size: 12px; color: var(--dim); margin: 8px 0 14px; }

  .serp { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; background: var(--surface); }
  .serp .u { font-size: 12px; color: var(--dim); }
  .serp .t { font-size: 17px; color: #9ab8ff; margin: 2px 0; }
  .serp .d { font-size: 13px; color: var(--soft); }

  .summary { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
  .summary span { font: 12px var(--mono); padding: 3px 10px; border-radius: 999px; border: 1px solid var(--line-2); }
  .result { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; cursor: pointer; }
  .result:hover { border-color: var(--line-2); background: var(--surface); }
  .result code { font: 11px var(--mono); color: var(--dim); }
  .result p { font-size: 12.5px; color: var(--soft); margin: 4px 0 6px; }
  .empty { color: var(--ok); font-size: 13px; }

  .preview { display: flex; flex-direction: column; min-width: 0; min-height: 0; background: #050608; }
  .preview .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 12px; border-bottom: 1px solid var(--line); }
  .devices { display: flex; gap: 4px; padding: 3px; border: 1px solid var(--line-2); border-radius: 999px; }
  .devices button { background: none; border: 0; padding: 4px 12px; border-radius: 999px; cursor: pointer; color: var(--dim); font-size: 12px; }
  .devices button span { font: 10px var(--mono); opacity: .7; margin-left: 4px; }
  .devices button[aria-pressed='true'] { background: var(--raise); color: var(--fg); }
  .stage { flex: 1; min-height: 0; overflow: hidden; position: relative; display: flex; justify-content: center; padding: 16px; }
  .frame { transform-origin: top center; border: 1px solid var(--line-2); border-radius: 12px; overflow: hidden; background: var(--bg); flex: none; }
  .frame iframe { display: block; border: 0; width: 100%; height: 100%; }

  @media (max-width: 1000px) {
    body { overflow: auto; }
    .shell { grid-template-columns: 1fr; height: auto; }
    .preview { height: 80vh; }
  }
</style>

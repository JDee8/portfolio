---
import cv from '../content/cv.json';
import { encodedEmail } from '../lib/email';
import SectionHead from './SectionHead.astro';
// Reference: cta.gallery big-statement CTAs. v1 had small centred pills;
// v2 makes the line the largest text in the section and Email the primary button.
---

<section class="section contact" id="contact" data-cmd-section="Contact">
  <SectionHead n="05" label="Contact" cmd="ping joao" tight />
  <div class="cta">
    <p class="big display reveal">{cv.site.contactLine}</p>
    <div class="actions reveal">
      <button class="btn primary lg" type="button" data-email={encodedEmail}>
        Email <span class="arrow" aria-hidden="true">→</span>
      </button>
      <a class="btn lg" href={cv.contact.linkedin} target="_blank" rel="noopener">
        LinkedIn <span class="arrow up" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact { padding-top: 180px; }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 32px 48px;
    margin-top: 28px;
    padding-top: 36px;
    border-top: 1px solid var(--line);
  }
  .big {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 5.6vw, 80px);
    line-height: 1.02;
    letter-spacing: -.03em;
    max-width: 14ch;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .lg { font-size: clamp(16px, 1.6vw, 19px); padding: 14px 26px; min-height: 52px; }
</style>

<script>
  import { openEmail } from '../scripts/email';
  import { toast } from '../scripts/toast';

  const button = document.querySelector<HTMLButtonElement>('.contact button[data-email]');
  button?.addEventListener('click', () => {
    openEmail(button.dataset.email!);
    toast('Opening your email app. No email app? LinkedIn works too.');
  });
</script>

---
import { sections } from '../lib/sections';
// Reference: navbar.gallery (floating pill, numbered links). The amber pill
// slides to the section you are reading, so the nav also shows where you are.
---

<header class="nav" data-nav>
  <a href="/" class="logo">jd<span class="dot">.</span><span class="sr-only"> João Dias, home</span></a>
  <nav class="pill cut" aria-label="Sections" data-spy-nav>
    <span class="ind" aria-hidden="true"></span>
    {sections.map((s) => (
      <a href={`/#${s.id}`} data-spy={s.id}><span class="n" aria-hidden="true">{s.n}</span>{s.label}</a>
    ))}
  </nav>
  <div class="right">
    <span class="clock mono" data-clock="LIS" aria-hidden="true"></span>
    <button class="kbtn cut" type="button" data-cmdk>
      <span data-cmdk-key>Ctrl K</span><span class="sr-only"> open command menu</span>
    </button>
    <button class="menu-btn cut" type="button" data-menu-open aria-expanded="false" aria-controls="menu">
      <span>Menu</span>
      <span class="burger" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    height: var(--nav-h);
    padding: 0 var(--gutter);
    font-size: 14px;
    transition: background .3s, border-color .3s;
    border-bottom: 1px solid transparent;
  }
  /* Only the bar behind the logo and buttons turns solid on phones, where the pill is hidden. */
  .nav.solid {
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-color: var(--line);
  }
  .logo {
    justify-self: start;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 21px;
    letter-spacing: -.02em;
    padding: 6px 4px;
  }
  .logo .dot { color: var(--accent); }

  .pill {
    --c: 12px;
    --fill: color-mix(in srgb, var(--surface) 92%, var(--bg));
    position: relative;
    display: flex;
    gap: 2px;
    padding: 4px;
  }
  .pill a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 7px 14px;
    color: var(--dim);
    transition: color .25s;
  }
  .pill a:hover { color: var(--fg); }
  .pill a[aria-current='true'] { color: var(--fg); }
  .n { font-family: var(--font-mono); font-size: 11px; color: var(--dim); transition: color .25s; }
  .pill a[aria-current='true'] .n { color: var(--accent); }
  .ind {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: var(--w, 0);
    transform: translateX(var(--x, 0));
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    box-shadow: inset 0 -2px 0 var(--accent);
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    opacity: var(--o, 0);
    transition: transform .45s var(--ease), width .45s var(--ease), opacity .3s;
  }

  .right { justify-self: end; display: flex; align-items: center; gap: 14px; }
  .clock { font-size: 12px; color: var(--dim); white-space: nowrap; }
  .kbtn, .menu-btn {
    --c: 10px;
    --fill: color-mix(in srgb, var(--surface) 92%, var(--bg));
    font-size: 13px;
    min-height: 36px;
    padding: 7px 16px;
    cursor: pointer;
    background: none;
  }
  .menu-btn { display: none; align-items: center; gap: 10px; min-height: 40px; }
  .burger { display: grid; gap: 4px; width: 14px; }
  .burger i { height: 1.5px; background: currentColor; border-radius: 2px; }

  @media (max-width: 1020px) {
    .clock { display: none; }
  }
  @media (max-width: 900px) {
    .nav { grid-template-columns: 1fr auto; }
    .pill, .kbtn { display: none; }
    .menu-btn { display: inline-flex; }
  }
</style>

<script>
  import { motionOff } from '../scripts/motion';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const pill = nav.querySelector<HTMLElement>('[data-spy-nav]')!;
  const links = [...pill.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const targets = links
    .map((a) => document.getElementById(a.dataset.spy!))
    .filter((el): el is HTMLElement => !!el);
  // The scroll scene sits between About and Projects and belongs to neither, so while it
  // plays no link is lit (before, "About" stayed lit for the whole scene).
  const scene = document.querySelector<HTMLElement>('[data-scene]');
  const marks = [
    ...targets.map((el) => ({ el, id: el.id })),
    ...(scene ? [{ el: scene, id: '' }] : []),
  ].sort((a, b) => (a.el.compareDocumentPosition(b.el) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1));

  // Scroll spy: the active section is the last one whose top has passed 40% of the screen.
  let current = '';
  function spy() {
    nav.classList.toggle('solid', scrollY > 40);
    if (!targets.length) return;
    const line = innerHeight * 0.4;
    let id = '';
    for (const m of marks) if (m.el.getBoundingClientRect().top < line) id = m.id;
    // Past the last section's end (footer), keep it lit.
    if (id === current) return;
    current = id;
    const a = links.find((l) => l.dataset.spy === id);
    links.forEach((l) => l.toggleAttribute('aria-current', false));
    if (a) {
      a.setAttribute('aria-current', 'true');
      pill.style.setProperty('--x', `${a.offsetLeft}px`);
      pill.style.setProperty('--w', `${a.offsetWidth}px`);
      pill.style.setProperty('--o', '1');
    } else {
      pill.style.setProperty('--o', '0');
    }
  }
  let queued = false;
  addEventListener('scroll', () => {
    if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; spy(); }); }
  }, { passive: true });
  addEventListener('resize', () => { current = '#'; spy(); });
  document.fonts?.ready.then(() => { current = '#'; spy(); });
  spy();

  // Smooth scroll respects the animation switch.
  links.forEach((a) => a.addEventListener('click', (e) => {
    const el = document.getElementById(a.dataset.spy!);
    if (!el) return;
    e.preventDefault();
    el.scrollIntoView({ behavior: motionOff() ? 'auto' : 'smooth', block: 'start' });
    history.replaceState(null, '', `#${el.id}`);
  }));
</script>

---
import cv from '../content/cv.json';
import ProjectCard from './ProjectCard.astro';
import SectionHead from './SectionHead.astro';
const contexts = [...new Set(cv.projects.map((p) => p.context))];
---

<section class="section" id="work" data-cmd-section="Projects">
  <SectionHead n="02" label="Projects" cmd="ls ~/projects" />
  <p class="ls mono reveal" aria-hidden="true">total {cv.projects.length} <span>·</span> {contexts.join(', ')}</p>
  <div class="list">
    {cv.projects.map((project, i) => <ProjectCard project={project} index={i} total={cv.projects.length} />)}
  </div>
</section>

<style>
  .ls { margin: -32px 0 32px; font-size: 13px; color: var(--dim); }
  .ls span { color: var(--line-2); }
</style>

<script>
  import { mountArt } from '../scripts/art';

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-art]').forEach(mountArt);

  // A soft light follows the cursor over each animation panel (mouse and trackpad only).
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-glare]').forEach((panel) => {
      panel.addEventListener('pointermove', (e) => {
        const r = panel.getBoundingClientRect();
        panel.style.setProperty('--gx', `${((e.clientX - r.left) / r.width) * 100}%`);
        panel.style.setProperty('--gy', `${((e.clientY - r.top) / r.height) * 100}%`);
      });
    });
  }
</script>

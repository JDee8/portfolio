---
import cv from '../content/cv.json';
import { encodedEmail } from '../lib/email';

// "SOC analyst in Lisbon. I triage…" → first sentence highlighted.
const [lead, ...rest] = cv.site.heroRole.split(/(?<=\.)\s+/);
// References: Awwwards portfolios with a HUD frame (urbik, SteinCode). v1 hid
// every way to act below the fold; v2 puts Email and LinkedIn on the first screen.
---

<section class="hero" id="top" data-particles data-text={cv.name.toUpperCase()}>
  <canvas aria-hidden="true"></canvas>
  <div class="glow" aria-hidden="true"></div>
  <div class="floor" aria-hidden="true"></div>
  <div class="frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <h1 class="sr-only">{cv.name}, {cv.headline}</h1>
  <div class="bottom">
    <div class="left">
      <p class="role display"><span>{lead}</span> {rest.join(' ')}</p>
      <div class="ctas">
        <button class="btn primary" type="button" data-email={encodedEmail}>Email me <span class="arrow" aria-hidden="true">→</span></button>
        <a class="btn" href={cv.contact.linkedin} target="_blank" rel="noopener">LinkedIn <span class="arrow up" aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="right">
      <ul class="focus" aria-label="Focus areas">
        {cv.site.focus.map((f) => <li>{f}</li>)}
      </ul>
      <p class="coords mono" aria-hidden="true">38.72°N 9.14°W <span>·</span> scroll <span class="down">↓</span></p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: min(100svh, 1600px);
    min-height: 600px;
    overflow: hidden;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
    /* --exit goes 0 → 1 as the hero scrolls away: the name sinks and fades. */
    opacity: calc(1 - var(--exit, 0) * 1.15);
    transform: translate3d(0, calc(var(--exit, 0) * 22vh), 0);
  }
  .glow {
    position: absolute;
    inset: auto 0 -40% 0;
    height: 80%;
    /* Blue (secure) glow under the name, with a faint red (threat) edge at the very bottom. */
    background:
      radial-gradient(50% 50% at 50% 50%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%),
      radial-gradient(60% 18% at 50% 100%, color-mix(in srgb, var(--alert) 16%, transparent), transparent 75%);
    pointer-events: none;
  }

  /* A faint red perspective grid on the "floor": the threat state the scroll scene starts from,
     so the hero leads into the lock instead of ending before it. Static CSS, no animation. */
  .floor {
    position: absolute;
    inset: auto -10% 0;
    height: 42%;
    perspective: 480px;
    pointer-events: none;
    opacity: calc(1 - var(--exit, 0) * 1.4);
    -webkit-mask-image: linear-gradient(transparent, #000 45%, rgba(0, 0, 0, .3));
    mask-image: linear-gradient(transparent, #000 45%, rgba(0, 0, 0, .3));
  }
  .floor::before {
    content: '';
    position: absolute;
    inset: 0;
    transform-origin: 50% 100%;
    transform: rotateX(66deg) scale(1.7);
    background:
      repeating-linear-gradient(90deg, color-mix(in srgb, var(--alert) 30%, transparent) 0 1px, transparent 1px 72px),
      repeating-linear-gradient(0deg, color-mix(in srgb, var(--alert) 30%, transparent) 0 1px, transparent 1px 72px);
  }

  /* Four corner brackets frame the name like a monitor view. */
  .frame {
    position: absolute;
    inset: calc(var(--nav-h) + 12px) var(--gutter) 200px;
    pointer-events: none;
    opacity: calc(1 - var(--exit, 0) * 3);
  }
  .frame i { position: absolute; width: 26px; height: 26px; border: 0 solid color-mix(in srgb, var(--accent) 70%, transparent); filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 60%, transparent)); }
  .frame i:nth-child(1) { left: 0; top: 0; border-left-width: 2px; border-top-width: 2px; }
  .frame i:nth-child(2) { right: 0; top: 0; border-right-width: 2px; border-top-width: 2px; }
  .frame i:nth-child(3) { left: 0; bottom: 0; border-left-width: 2px; border-bottom-width: 2px; }
  .frame i:nth-child(4) { right: 0; bottom: 0; border-right-width: 2px; border-bottom-width: 2px; }

  .bottom {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px 40px;
    padding: 0 var(--gutter) 32px;
    pointer-events: none;
    opacity: calc(1 - var(--exit, 0) * 2.5);
  }
  .left, .right { display: grid; gap: 20px; }
  .right { justify-items: end; text-align: right; }
  .ctas, .focus { pointer-events: auto; }
  .role {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, 2.1vw, 28px);
    line-height: 1.2;
    letter-spacing: -.01em;
    max-width: 30ch;
    color: var(--soft);
  }
  .role span { color: var(--accent); }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  .focus { display: flex; flex-wrap: wrap; justify-content: end; gap: 8px; list-style: none; }
  .focus li {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--soft);
    padding: 5px 14px 5px 15px;
    background: color-mix(in srgb, var(--accent) 9%, var(--surface));
    box-shadow: inset 2px 0 0 var(--accent);
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
  }
  .coords { font-size: 12px; color: var(--dim); }
  .coords span { color: var(--line-2); }
  /* Nudges three times after load to point at the page below, then stays still. */
  .coords .down { color: var(--accent); display: inline-block; animation: nudge 2.4s var(--ease) 2s 3; }
  @keyframes nudge { 0%, 60%, 100% { transform: none; } 30% { transform: translateY(3px); } }

  /* Entrance: role, buttons and meta arrive after the particles start to settle. */
  .role, .ctas, .right { opacity: 0; transform: translateY(10px); transition: opacity 1s, transform 1s var(--ease); }
  .role { transition-delay: 1.1s; }
  .ctas { transition-delay: 1.3s; }
  .right { transition-delay: 1.45s; }
  .hero:global(.ready) .role,
  .hero:global(.ready) .ctas,
  .hero:global(.ready) .right { opacity: 1; transform: none; }
  :global(html:not(.js)) .role, :global(html:not(.js)) .ctas, :global(html:not(.js)) .right { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .bottom { flex-direction: column; align-items: start; padding-bottom: 24px; }
    .right { justify-items: start; text-align: left; }
    .focus { justify-content: start; }
    .frame { bottom: 300px; }
    .coords { display: none; }
  }
</style>

<script>
  import { particleText } from '../scripts/particles';
  import { motionOff } from '../scripts/motion';
  import { openEmail } from '../scripts/email';
  import { toast } from '../scripts/toast';

  const host = document.querySelector<HTMLElement>('.hero[data-particles]');
  const canvas = host?.querySelector('canvas');
  if (host && canvas) {
    particleText(canvas, host);

    let queued = false;
    const exit = () => {
      queued = false;
      const p = motionOff() ? 0 : Math.min(1, scrollY / host.offsetHeight);
      host.style.setProperty('--exit', p.toFixed(3));
    };
    addEventListener('scroll', () => {
      if (!queued) { queued = true; requestAnimationFrame(exit); }
    }, { passive: true });
    addEventListener('jd:motion', exit);
    exit();

    const email = host.querySelector<HTMLButtonElement>('[data-email]');
    email?.addEventListener('click', () => {
      openEmail(email.dataset.email!);
      toast('Opening your email app. No email app? LinkedIn works too.');
    });
  }
</script>

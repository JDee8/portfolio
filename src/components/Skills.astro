---
import cv from '../content/cv.json';
import SectionHead from './SectionHead.astro';

// "cat skills.txt" prints a file, so v2 shows one: numbered lines, a comment
// per group, then the entries. Rows scan faster than v1's 3×2 grid of boxes.
const extra: [string, string[]][] = [
  ['Knowledge level', cv.knowledgeLevel],
  ['Compliance training', cv.compliance],
  ['Languages', cv.languages.map((l) => `${l.name} (${l.level.toLowerCase()})`)],
];
const count = cv.skills.reduce((n, s) => n + s.items.length, 0);
---

<section class="section" id="skills" data-cmd-section="Skills">
  <SectionHead n="04" label="Skills" cmd="cat skills.txt" />
  <div class="window file reveal">
    <div class="window-bar"><span><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>skills.txt</span><span aria-hidden="true">{cv.skills.length} groups · {count} entries</span></div>
    <ol class="lines">
      {cv.skills.map((s) => (
        <li>
          <h3 class="grp mono"><span aria-hidden="true"># </span>{s.group}</h3>
          <div class="tags">{s.items.map((i) => <span>{i}</span>)}</div>
        </li>
      ))}
      <li class="gap" aria-hidden="true"></li>
      {extra.map(([k, v]) => (
        <li class="plain">
          <h3 class="grp mono"><span aria-hidden="true"># </span>{k}</h3>
          <p>{v.join(' · ')}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .lines { list-style: none; counter-reset: ln; padding: 8px 0; }
  .lines li {
    counter-increment: ln;
    position: relative;
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 24px;
    align-items: baseline;
    padding: 12px 20px 12px 64px;
    transition: background .25s;
  }
  .lines li::before {
    content: counter(ln);
    position: absolute;
    left: 0;
    width: 44px;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--line-2);
    top: 15px;
  }
  .lines li:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .lines li:hover::before { color: var(--dim); }
  .grp { font-size: 13px; font-weight: 400; color: var(--soft); }
  .grp span { color: var(--accent); }
  .lines li.gap { min-height: 24px; padding: 0; }
  .lines li.gap::before { top: 4px; }
  .plain p { color: var(--soft); font-size: 15px; }
  .plain .grp { color: var(--dim); }

  @media (max-width: 760px) {
    .lines li { grid-template-columns: 1fr; gap: 8px; padding: 12px 16px 12px 48px; }
    .lines li::before { width: 32px; }
  }
</style>

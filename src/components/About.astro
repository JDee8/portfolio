---
import cv from '../content/cv.json';
import SectionHead from './SectionHead.astro';

// Reference: 21st.dev statement (bright first clause, dimmed rest).
// The first paragraph becomes the statement; its first sentence is bright.
const [first, ...more] = cv.site.about;
const [lead, ...tail] = first.split(/(?<=\.)\s+/);

// The facts read as the output of "whoami --long", matching the heading.
const certified = cv.certifications.filter((c) => c.status === 'Certified');
const certs = certified.map((c) => c.name.replace(`${c.issuer} `, '')).join(', ');
const issuer = certified.every((c) => c.issuer === certified[0]?.issuer) ? `${certified[0].issuer} ` : '';
const job = cv.experience.find((e) => !e.end) ?? cv.experience[0];
const cet = cv.education[0];
const facts: [string, string][] = [
  ['role', job.role],
  ['org', job.org.replace(/\s*\(.*\)$/, '')],
  ['based', cv.location],
  ['certs', `${issuer}${certs}`],
  ['school', `CET Cybersecurity · ${cet.note.replace('Final grade ', '')}`],
  ['langs', cv.languages.map((l) => l.name).join(', ')],
];
---

<section class="section" id="about" data-cmd-section="About">
  <SectionHead n="01" label="About" cmd="whoami" />
  <div class="cols">
    <div class="text">
      <p class="statement display reveal"><span>{lead}</span> {tail.join(' ')}</p>
      {more.map((p) => <p class="body reveal">{p}</p>)}
    </div>
    <div class="window reveal">
      <div class="window-bar"><span><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>~ whoami --long</span><span aria-hidden="true">{facts.length} lines</span></div>
      <dl class="kv">
        {facts.map(([k, v]) => (
          <div><dt class="mono">{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 64px;
    align-items: start;
  }
  .statement {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 2.7vw, 38px);
    line-height: 1.2;
    letter-spacing: -.015em;
    color: var(--dim);
    max-width: 24ch;
  }
  .statement span { color: var(--fg); }
  .body {
    margin-top: 22px;
    font-size: clamp(16px, 1.3vw, 18px);
    color: var(--soft);
    max-width: 52ch;
  }
  .statement + .body { margin-top: 32px; }

  .kv { padding: 6px 0; }
  .kv div {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 16px;
    padding: 11px 18px;
    border-bottom: 1px dashed var(--line);
  }
  .kv div:last-child { border-bottom: 0; }
  dt { font-size: 13px; color: var(--dim); padding-top: 2px; }
  dt::after { content: ':'; color: var(--line-2); }
  dd { font-weight: 500; }

  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr; gap: 40px; }
  }
</style>

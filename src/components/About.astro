---
import cv from '../content/cv.json';
import CmdHeading from './CmdHeading.astro';

// "CompTIA Security+ and A+" instead of repeating the issuer.
const certified = cv.certifications.filter((c) => c.status === 'Certified');
const sameIssuer = certified.every((c) => c.issuer === certified[0]?.issuer);
const certText = sameIssuer
  ? `${certified[0].issuer} ${certified.map((c) => c.name.replace(`${c.issuer} `, '')).join(' and ')}`
  : certified.map((c) => c.name).join(', ');
const cet = cv.education[0];
const facts = [
  ['Based in', cv.location],
  ['Certified', certText],
  ['Specialization', `CET Cybersecurity, ${cet.note.replace('Final grade ', '')}`],
  ['Languages', cv.languages.map((l) => l.name).join(', ')],
];
---

<section class="section" id="about" data-cmd-section="About">
  <p class="eyebrow reveal">About</p>
  <CmdHeading label="About" cmd="whoami" />
  <div class="cols">
    <div class="text">
      {cv.site.about.map((p) => <p class="reveal">{p}</p>)}
    </div>
    <dl class="facts reveal">
      {facts.map(([k, v]) => (
        <div><dt>{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .text p {
    font-size: clamp(17px, 1.5vw, 20px);
    color: var(--soft);
    max-width: 52ch;
  }
  .text p + p { margin-top: 18px; }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  .facts div { background: var(--bg); padding: 16px 18px; }
  dt { font-size: 12px; color: var(--dim); letter-spacing: .06em; text-transform: uppercase; }
  dd { margin-top: 4px; font-weight: 500; }
  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 480px) {
    .facts { grid-template-columns: 1fr; }
  }
</style>

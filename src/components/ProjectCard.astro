---
// One project as a full-width row: animation panel on one side, details on the
// other, alternating. v1 hid the details behind a "How I built it" toggle;
// "don't make me think" says show them, so recruiters read them without a click.
interface Props {
  index: number;
  total: number;
  project: {
    title: string;
    context: string;
    summary: string;
    points: string[];
    tags: string[];
    art: string;
    artCaption?: string;
  };
}
const { project, index, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<article class:list={['row', { flip: index % 2 === 1 }]}>
  <figure class="art cut reveal" data-glare>
    <figcaption class="art-bar mono">
      <span>fig.{pad(index + 1)}</span>
      <span class="cap">{project.artCaption}</span>
    </figcaption>
    <div class="canvas"><canvas data-art={project.art} aria-hidden="true"></canvas></div>
    <div class="glare" aria-hidden="true"></div>
  </figure>
  <div class="text">
    <p class="meta mono reveal"><span class="idx">{pad(index + 1)}</span><span class="of">/{pad(total)}</span> · {project.context}</p>
    <h3 class="reveal">{project.title}</h3>
    <p class="summary reveal">{project.summary}</p>
    <ul class="points reveal">{project.points.map((p) => <li>{p}</li>)}</ul>
    <div class="tags reveal">{project.tags.map((t) => <span>{t}</span>)}</div>
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 56px;
    align-items: center;
    padding: 56px 0;
    border-top: 1px solid var(--line);
  }
  .row:last-child { border-bottom: 1px solid var(--line); }
  .flip .art { order: 2; }

  .art {
    --c: 26px;
    overflow: hidden;
    transition: --edge-a .35s, --edge-b .35s, opacity 1s, transform 1.1s var(--ease);
  }
  .art-bar {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px 12px 30px;
    border-bottom: 1px solid var(--line-2);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    font-size: 12px;
    color: var(--dim);
  }
  .art-bar span:first-child { color: var(--accent); }
  .cap { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .canvas {
    height: clamp(240px, 26vw, 320px);
    background: radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 60%);
  }
  canvas { width: 100%; height: 100%; }
  .glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity .3s;
    background: radial-gradient(420px circle at var(--gx, 50%) var(--gy, 50%), color-mix(in srgb, var(--accent) 10%, transparent), transparent 45%);
  }
  .art:hover .glare { opacity: 1; }

  .meta { font-size: 12px; color: var(--dim); margin-bottom: 14px; }
  .idx { color: var(--accent); }
  .of { color: var(--dim); opacity: .6; }
  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(26px, 2.8vw, 38px);
    letter-spacing: -.02em;
    line-height: 1.1;
  }
  .summary { margin-top: 12px; color: var(--soft); font-size: clamp(16px, 1.3vw, 18px); max-width: 44ch; }
  .points { margin-top: 18px; padding-left: 18px; color: var(--soft); font-size: 15px; max-width: 52ch; }
  .points li + li { margin-top: 7px; }
  .points li::marker { color: var(--accent); }
  .tags { margin-top: 20px; }

  @media (max-width: 900px) {
    .row { grid-template-columns: 1fr; gap: 28px; padding: 40px 0; }
    .flip .art { order: 0; }
  }
  @media (max-width: 560px) {
    .cap { white-space: normal; text-align: right; }
  }
</style>

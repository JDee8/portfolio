---
// Scroll-scrubbed video: scattered particles assemble into a shield as you scroll.
// Clip made with Kling from frames rendered by tools/make-kling-frames.mjs.
---

<section class="scene" data-scene aria-label="Security alerts: monitored, triaged, contained.">
  <div class="stage">
    <video
      muted
      playsinline
      disablepictureinpicture
      preload="none"
      data-src-portrait="/video/shield-portrait"
      data-src-small="/video/shield-480"
      data-src-large="/video/shield-720"
      data-poster-portrait="/video/shield-first-portrait.webp"
      data-poster="/video/shield-first.webp"
      aria-hidden="true"
    ></video>
    <picture class="still" aria-hidden="true">
      <source media="(max-aspect-ratio: 1/1)" srcset="/video/shield-last-portrait.webp" />
      <img src="/video/shield-last.webp" alt="" loading="lazy" decoding="async" />
    </picture>
    <!-- Each line shows while scroll progress is inside its data-from/data-to window,
         matching the clip's phases: scattered particles, grid, shield. -->
    <div class="caption" aria-hidden="true">
      <p class="line" data-from="0" data-to="0.36"><span>$</span> tail -f alerts.log</p>
      <p class="line" data-from="0.40" data-to="0.56"><span>$</span> triage --all</p>
      <p class="line" data-from="0.60" data-to="1"><span>[ ok ]</span> contained</p>
    </div>
  </div>
</section>

<style>
  .scene {
    position: relative;
    height: 260vh; /* scroll distance that plays the clip */
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: var(--bg);
  }
  /* Soft top and bottom edges so the scene melts into the page. */
  .stage::before,
  .stage::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 18%;
    z-index: 1;
    pointer-events: none;
  }
  .stage::before { top: 0; background: linear-gradient(var(--bg), transparent); }
  .stage::after { bottom: 0; background: linear-gradient(transparent, var(--bg)); }

  video,
  .still img {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: max(100vw, 177.78svh); /* 16:9 file, covers the stage like object-fit: cover */
    height: auto;
  }
  .still { display: none; }
  /* Portrait screens use the 9:16 crop, so the shield fills the width at full sharpness. */
  @media (max-aspect-ratio: 1/1) {
    video, .still img { width: max(100vw, 56.25svh); }
  }

  .caption {
    position: absolute;
    left: var(--gutter);
    bottom: 12svh;
    z-index: 2;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(22px, 3.2vw, 44px);
    line-height: 1.1;
    letter-spacing: -.035em;
  }
  .line {
    position: absolute;
    bottom: 0;
    white-space: nowrap;
  }
  .line span { color: var(--accent); }
  .line:not(:first-child) { opacity: 0; } /* before the script runs */

  /* Animations off: no scroll distance, no video, just the finished shield and the last line. */
  :global(html[data-motion='off']) .scene { height: auto; }
  :global(html[data-motion='off']) .stage { position: relative; height: min(100svh, 760px); }
  :global(html[data-motion='off']) video { display: none; }
  :global(html[data-motion='off']) .still { display: block; }
  :global(html[data-motion='off']) .line { opacity: 0 !important; }
  :global(html[data-motion='off']) .line:last-child { opacity: 1 !important; transform: none !important; }
</style>

<script>
  import { motionOff } from '../scripts/motion';

  const scene = document.querySelector<HTMLElement>('[data-scene]');
  const video = scene?.querySelector('video');
  if (scene && video) {
    let loaded = false, current = 0, queued = false;
    const portrait = innerHeight > innerWidth;
    video.poster = (portrait ? video.dataset.posterPortrait : video.dataset.poster) ?? '';

    // Load the clip one screen before it is needed: a 9:16 crop for portrait
    // screens, 480p for small or data-saving landscape screens, 720p otherwise.
    // AV1 where the browser supports it (~25% smaller), H.264 everywhere else.
    const load = () => {
      if (loaded || motionOff()) return;
      loaded = true;
      const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
      const base = portrait ? video.dataset.srcPortrait
        : innerWidth < 760 || saveData ? video.dataset.srcSmall
        : video.dataset.srcLarge;
      const av1 = video.canPlayType('video/mp4; codecs="av01.0.05M.08"') === 'probably';
      video.src = `${base}${av1 ? '.av1' : ''}.mp4`;
      video.preload = 'auto';
      video.load();
    };
    // Preload only once the visitor has scrolled, so people who never leave the hero
    // don't download the clip (on tall desktop screens the scene starts within reach).
    let near = false, scrolled = false;
    new IntersectionObserver(([entry]) => {
      near = entry.isIntersecting;
      if (near && scrolled) load();
    }, { rootMargin: '100% 0px' }).observe(scene);
    addEventListener('scroll', () => { scrolled = true; if (near) load(); }, { passive: true, once: true });

    // Captions: each line fades in at the start of its window and out at the end.
    const FADE = 0.04;
    const clamp01 = (n: number) => Math.min(1, Math.max(0, n));
    const lines = [...scene.querySelectorAll<HTMLElement>('.line')].map((el) => ({
      el, from: Number(el.dataset.from), to: Number(el.dataset.to),
    }));
    const captions = (p: number) => {
      for (const { el, from, to } of lines) {
        const fadeIn = from <= 0 ? 1 : clamp01((p - from) / FADE);
        const fadeOut = to >= 1 ? 1 : clamp01((to - p) / FADE);
        const o = Math.min(fadeIn, fadeOut);
        el.style.opacity = String(o);
        el.style.transform = `translateY(${(1 - o) * (fadeIn < 1 ? 14 : -14)}px)`;
      }
    };

    // Scroll position → video time. Only one seek runs at a time so phones keep up.
    const update = () => {
      queued = false;
      if (motionOff()) return;
      const r = scene.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
      captions(p);
      if (!video.duration || video.readyState < 2) return;
      const target = p * (video.duration - 0.05);
      current += (target - current) * 0.35;
      if (Math.abs(target - current) < 0.002) current = target;
      if (!video.seeking && Math.abs(video.currentTime - current) > 1 / 60) video.currentTime = current;
      if (Math.abs(target - current) > 0.002) request();
    };
    const request = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };

    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    video.addEventListener('loadeddata', request);
    video.addEventListener('seeked', request);
    addEventListener('jd:motion', () => { load(); request(); });
    request();
  }
</script>

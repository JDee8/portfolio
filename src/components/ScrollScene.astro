---
// Scroll-scrubbed scene, drawn in code (src/scripts/shield.ts): a padlock cracks,
// shatters and re-forms as a shield as you scroll. Replaces the Kling video clip.
// The three phases match the captions: detect, triage, contain.
---

<section class="scene" data-scene aria-label="Security alerts: monitored, triaged, contained.">
  <div class="stage">
    <canvas aria-hidden="true"></canvas>
    <!-- Each line shows while scroll progress is inside its data-from/data-to window. -->
    <div class="caption" aria-hidden="true">
      <p class="line" data-from="0" data-to="0.29"><span>$</span> tail -f alerts.log</p>
      <p class="line" data-from="0.33" data-to="0.56"><span>$</span> triage --all</p>
      <p class="line" data-from="0.62" data-to="1"><span>[ ok ]</span> contained</p>
    </div>
    <div class="hud mono cut" aria-hidden="true">
      <ol class="phases">
        <li data-from="0" data-to="0.31"><b>01</b> detect</li>
        <li data-from="0.31" data-to="0.6"><b>02</b> triage</li>
        <li data-from="0.6" data-to="1.01"><b>03</b> contain</li>
      </ol>
      <div class="bar"><span></span></div>
    </div>
  </div>
</section>

<style>
  .scene {
    position: relative;
    height: 220vh; /* scroll distance that plays the scene */
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: var(--bg);
  }
  /* Soft top and bottom edges so the scene melts into the page. */
  .stage::before,
  .stage::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 16%;
    z-index: 1;
    pointer-events: none;
  }
  .stage::before { top: 0; background: linear-gradient(var(--bg), transparent); }
  .stage::after { bottom: 0; background: linear-gradient(transparent, var(--bg)); }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }

  .caption {
    position: absolute;
    left: var(--gutter);
    bottom: 11svh;
    z-index: 2;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(22px, 3.2vw, 44px);
    line-height: 1.1;
    letter-spacing: -.035em;
    text-shadow: 0 0 28px color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .line { position: absolute; bottom: 0; white-space: nowrap; }
  .line span { color: var(--accent); }
  .line:not(:first-child) { opacity: 0; } /* before the script runs */

  .hud {
    --c: 12px;
    --fill: color-mix(in srgb, var(--surface) 94%, var(--bg));
    position: absolute;
    right: var(--gutter);
    bottom: 11svh;
    z-index: 2;
    width: 220px;
    padding: 14px 16px;
    font-size: 12px;
    color: var(--dim);
  }
  .phases { list-style: none; display: grid; gap: 6px; margin-bottom: 12px; }
  .phases li { transition: color .3s; }
  .phases b { font-weight: 400; color: var(--dim); opacity: .6; margin-right: 8px; transition: color .3s, opacity .3s; }
  .phases li:global(.on) b { opacity: 1; }
  .phases li:global(.on) { color: var(--fg); }
  .phases li:global(.on) b { color: var(--accent); }
  .bar { height: 2px; background: var(--line-2); overflow: hidden; }
  .bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--alert), var(--accent) 60%); transform-origin: left; transform: scaleX(var(--p, 0)); }
  @media (max-width: 760px) {
    .hud { left: var(--gutter); right: auto; bottom: auto; top: calc(var(--nav-h) + 20px); width: 160px; }
  }

  /* Animations off: no scroll distance, just the finished shield and the last line. */
  :global(html[data-motion='off']) .scene { height: auto; }
  :global(html[data-motion='off']) .stage { position: relative; height: min(100svh, 760px); }
  :global(html[data-motion='off']) .line { opacity: 0 !important; }
  :global(html[data-motion='off']) .line:last-child { opacity: 1 !important; transform: none !important; }
  :global(html[data-motion='off']) .hud { display: none; }
</style>

<script>
  import { motionOff } from '../scripts/motion';
  import { shieldScene } from '../scripts/shield';

  const scene = document.querySelector<HTMLElement>('[data-scene]');
  const canvas = scene?.querySelector('canvas');
  if (scene && canvas) {
    const clamp01 = (n: number) => Math.min(1, Math.max(0, n));
    const progress = () => {
      const r = scene.getBoundingClientRect();
      return clamp01(-r.top / (r.height - innerHeight));
    };

    // Captions: each line fades in at the start of its window and out at the end.
    const FADE = 0.04;
    const lines = [...scene.querySelectorAll<HTMLElement>('.line')].map((el) => ({
      el, from: Number(el.dataset.from), to: Number(el.dataset.to),
    }));
    const phases = [...scene.querySelectorAll<HTMLElement>('.phases li')].map((el) => ({
      el, from: Number(el.dataset.from), to: Number(el.dataset.to),
    }));
    const captions = () => {
      if (motionOff()) return;
      const p = progress();
      scene.style.setProperty('--p', p.toFixed(3));
      for (const { el, from, to } of phases) el.classList.toggle('on', p >= from && p < to);
      for (const { el, from, to } of lines) {
        const fadeIn = from <= 0 ? 1 : clamp01((p - from) / FADE);
        const fadeOut = to >= 1 ? 1 : clamp01((to - p) / FADE);
        const o = Math.min(fadeIn, fadeOut);
        el.style.opacity = String(o);
        el.style.transform = `translateY(${(1 - o) * (fadeIn < 1 ? 14 : -14)}px)`;
      }
    };
    let queued = false;
    const request = () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; captions(); }); } };
    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    addEventListener('jd:motion', request);
    captions();

    shieldScene(canvas, scene, () => (motionOff() ? 1 : progress()));
  }
</script>
